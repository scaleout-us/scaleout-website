---
import Base from '../layouts/Base.astro';
---

<Base title="Website Monitoring & AI Chatbot — ScaleOut LLC" navVariant="subscribe">

  <!-- HERO -->
  <section id="hero">
    <div class="hero-badge"><span class="dot"></span> Website Monitoring · AI Chatbots</div>
    <h1>Keep Your Website <span class="grad">Working</span>—<br>and Ready to Help</h1>
    <p>A website should be available when customers need it and helpful when they have questions. ScaleOut LLC makes it easier to keep an eye on your site and give visitors answers—without adding more to your team’s plate.</p>
  </section>

  <!-- OFFERS -->
  <section id="offers">
    <div class="offers-grid">

      <!-- OFFER 1: FREE MONITORING -->
      <div class="offer-card">
        <div class="offer-icon">📡</div>
        <h2>Free Website Health Monitoring for One Year</h2>
        <p class="offer-desc">Know when your website may be unavailable. We’ll check your site’s uptime every <strong>5 minutes</strong> and send an alert to the email address you choose if it goes down.</p>
        <p class="offer-highlight"><strong>Your first year is free.</strong> Get a little extra peace of mind while you focus on running your business.</p>

        <div class="offer-form">
          <form name="subscribe-monitoring" method="POST" action="/subscribe/" netlify netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="subscribe-monitoring" />
            <input type="hidden" name="offer" value="free-website-monitoring" />
            <p class="bot-field">
              <label>Don't fill this out if you're human! <input name="bot-field" /></label>
            </p>
            <div class="form-row">
              <div class="form-group">
                <label for="mon-name">Name</label>
                <input id="mon-name" type="text" name="name" placeholder="Your name" autocomplete="name" />
              </div>
              <div class="form-group">
                <label for="mon-phone">Phone Number</label>
                <input id="mon-phone" type="tel" name="phone" placeholder="(555) 123-4567" autocomplete="tel" />
              </div>
            </div>
            <div class="form-group">
              <label for="mon-company">Company Name</label>
              <input id="mon-company" type="text" name="company" placeholder="Your company" autocomplete="organization" />
            </div>
            <div class="form-group">
              <label for="mon-email">Email <span class="req">*</span></label>
              <input id="mon-email" type="email" name="email" required placeholder="you@yourbusiness.com" autocomplete="email" />
            </div>
            <div class="form-group">
              <label for="mon-url">Website URL <span class="req">*</span></label>
              <input id="mon-url" type="url" name="website" required placeholder="https://www.yourbusiness.com" inputmode="url" />
            </div>
            <button type="submit" class="btn-primary">Get Started with Free Monitoring</button>
            <p class="form-note">No commitment. We’ll email you within one business day.</p>
          </form>
        </div>
      </div>

      <!-- OFFER 2: AI CHATBOT -->
      <div class="offer-card">
        <div class="offer-icon">💬</div>
        <h2>Add a Website AI Chatbot for $499 per Year</h2>
        <p class="offer-desc">Give website visitors a helpful way to learn about your business, services, and offerings. We’ll create an AI chatbot with deep knowledge of your business, so it can respond to questions using information relevant to what you do.</p>
        <p class="offer-highlight"><strong>Just $499 per year.</strong></p>

        <div class="offer-form">
          <form name="subscribe-chatbot" method="POST" action="/subscribe/" netlify netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="subscribe-chatbot" />
            <input type="hidden" name="offer" value="website-chatbot" />
            <p class="bot-field">
              <label>Don't fill this out if you're human! <input name="bot-field" /></label>
            </p>
            <div class="form-row">
              <div class="form-group">
                <label for="chat-name">Name</label>
                <input id="chat-name" type="text" name="name" placeholder="Your name" autocomplete="name" />
              </div>
              <div class="form-group">
                <label for="chat-phone">Phone Number</label>
                <input id="chat-phone" type="tel" name="phone" placeholder="(555) 123-4567" autocomplete="tel" />
              </div>
            </div>
            <div class="form-group">
              <label for="chat-company">Company Name</label>
              <input id="chat-company" type="text" name="company" placeholder="Your company" autocomplete="organization" />
            </div>
            <div class="form-group">
              <label for="chat-email">Email <span class="req">*</span></label>
              <input id="chat-email" type="email" name="email" required placeholder="you@yourbusiness.com" autocomplete="email" />
            </div>
            <div class="form-group">
              <label for="chat-url">Website URL <span class="req">*</span></label>
              <input id="chat-url" type="url" name="website" required placeholder="https://www.yourbusiness.com" inputmode="url" />
            </div>
            <button type="submit" class="btn-primary">Get Your Website Chatbot</button>
            <p class="form-note">No commitment. We’ll email you within one business day.</p>
          </form>
        </div>
      </div>

    </div>
  </section>

  <!-- ABOUT -->
  <section id="about">
    <h2>Practical Technology, Built Around Your Business</h2>
    <p>ScaleOut brings a hands-on, security-first approach to technology—from cloud engineering to practical AI integrations. We focus on useful solutions that fit your business and can grow with it.</p>
    <a href="/#cta" class="btn-primary" style="width:auto; display:inline-block;">Talk with ScaleOut</a>
  </section>

  <script>
    // Disable submit button while a Netlify form is submitting
    document.querySelectorAll('form[netlify]').forEach(form => {
      form.addEventListener('submit', (e) => {
        const btn = form.querySelector('button[type="submit"]');
        if (btn) { btn.disabled = true; }
      });
    });
  </script>
</Base>

<style>
  /* ── HERO ── */
  #hero {
    padding: 8.5rem 6% 3.5rem;
    text-align: center;
    background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(59,130,246,0.15), transparent),
                radial-gradient(ellipse 60% 40% at 80% 60%, rgba(99,102,241,0.1), transparent), var(--bg);
    position: relative;
  }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: rgba(59,130,246,0.1); border: 1px solid rgba(59,130,246,0.3);
    border-radius: 999px; padding: 0.35rem 1rem; font-size: 0.82rem;
    color: var(--accent); font-weight: 500; margin-bottom: 1.5rem;
  }
  .hero-badge .dot { width: 7px; height: 7px; background: var(--accent); border-radius: 50%; animation: pulse 2s infinite; }
  @keyframes pulse { 0%,100%{opacity:1;} 50%{opacity:0.3;} }
  #hero h1 { font-size: clamp(2rem, 5vw, 3.4rem); font-weight: 800; line-height: 1.15; margin-bottom: 1.25rem; }
  #hero h1 .grad { background: var(--grad); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  #hero p { font-size: clamp(1rem, 2vw, 1.15rem); color: var(--muted); max-width: 640px; margin: 0 auto; }

  /* ── OFFERS ── */
  #offers { padding: 3.5rem 6% 5rem; background: var(--bg2); }
  .offers-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; max-width: 1100px; margin: 0 auto; }
  .offer-card {
    background: var(--card); border: 1px solid var(--border); border-radius: 16px;
    padding: 2.25rem 2rem; display: flex; flex-direction: column;
    transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
  }
  .offer-card:hover { transform: translateY(-4px); border-color: rgba(59,130,246,0.4); box-shadow: 0 20px 40px rgba(0,0,0,0.3); }
  .offer-icon {
    width: 52px; height: 52px; border-radius: 12px;
    background: rgba(59,130,246,0.12); border: 1px solid rgba(59,130,246,0.2);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem; margin-bottom: 1.25rem;
  }
  .offer-card h2 { font-size: 1.35rem; font-weight: 600; margin-bottom: 0.9rem; }
  .offer-card .offer-desc { color: var(--muted); font-size: 0.93rem; line-height: 1.7; }
  .offer-card .offer-highlight { color: var(--text); font-size: 0.93rem; line-height: 1.7; margin-top: 0.9rem; }
  .offer-form { margin-top: 1.75rem; padding-top: 1.75rem; border-top: 1px solid var(--border); flex: 1; display: flex; flex-direction: column; }

  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
  .form-group { margin-bottom: 0.9rem; }
  .form-group label { display: block; font-size: 0.82rem; font-weight: 500; color: var(--muted); margin-bottom: 0.35rem; }
  .form-group label .req { color: var(--accent); }
  .form-group input {
    width: 100%; padding: 0.75rem 0.9rem;
    background: rgba(255,255,255,0.04); border: 1px solid var(--border); border-radius: 10px;
    color: var(--text); font-family: 'Inter', sans-serif; font-size: 0.93rem;
    transition: border-color 0.2s, background 0.2s;
  }
  .form-group input:focus { outline: none; border-color: var(--accent); background: rgba(59,130,246,0.05); }
  .form-group input::placeholder { color: rgba(148,163,184,0.5); }
  .btn-primary {
    background: var(--grad); color: #fff; padding: 0.85rem 2rem;
    border-radius: 10px; font-weight: 600; font-size: 1rem; border: none; cursor: pointer;
    font-family: 'Inter', sans-serif; width: 100%;
    box-shadow: 0 0 30px rgba(59,130,246,0.3); transition: transform 0.2s, box-shadow 0.2s;
  }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 0 40px rgba(59,130,246,0.5); }
  .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
  .form-note { margin-top: 0.9rem; font-size: 0.78rem; color: var(--muted); text-align: center; }
  /* Honeypot — hidden from users, visible to bots */
  .bot-field { position: absolute; left: -5000px; top: auto; height: 1px; width: 1px; overflow: hidden; }

  /* ── ABOUT ── */
  #about { padding: 5rem 6%; text-align: center; }
  #about h2 { font-size: clamp(1.6rem, 3.5vw, 2.2rem); font-weight: 700; margin-bottom: 1rem; }
  #about p { color: var(--muted); font-size: 1.05rem; max-width: 620px; margin: 0 auto 2rem; }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .form-row { grid-template-columns: 1fr; }
  }
</style>
